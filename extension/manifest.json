{
  "manifest_version": 3,
  "name": "E-ink Reader",
  "version": "0.1.0",
  "description": "Page-based reading for e-ink screens.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "eink-reader@soulthy.github.io",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
